# M5OpurSan config — microSD のルートに config.txt という名前で置く
#
# WiFi はオプション。この設定が無くても日本語入力・編集・SD 保存は
# すべてオフラインで動く。
#
# 書式:
#   KEY=VALUE の 1 行 1 項目。'#' から行末はコメント。空行は無視。
#   '=' の前後の空白は無視。知らないキーは黙って読み飛ばす。
#
# 注意:
#   アクセスポイントは WPA2-PSK 専用モードにすること。
#   WPA2/WPA3 混在モードでは ESP32-S3 が接続できない。
#   2.4GHz のみ対応（5GHz には繋がらない）。

WIFI_SSID=MyWiFi
WIFI_PASS=your-passphrase

# 書いたものの送信先。ESC メニューの「1 保存」のあと、/opur/ に溜まった
# 未送信ファイルを古いものから 1 件だけ送る（送れたら /opur/sent/ へ移す）。
#
# 相手が引き取るまでは送らないので、この行を消しても書いたものは
# SD に残り続ける。WiFi が無い場所では黙って送信を飛ばす。
#
# URL は EQIDEN が発行する「https://eqiden.com/ + 64桁の16進トークン」。
# 手元で試すなら:
#   curl -s URL                      … 中身を見る（空なら送信可）
#   curl -X PUT -d "" URL            … 引き取って空に戻す
#
# ENDPOINT_URL=https://eqiden.com/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
